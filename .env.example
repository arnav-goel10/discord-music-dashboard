DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Optional: shard for higher scale guild counts.
# Keep disabled for small bots. Enable when you need horizontal gateway scaling.
AUTO_SHARDING_ENABLED=0
# Optional when auto sharding is enabled:
# DISCORD_SHARD_COUNT=2
# DISCORD_SHARD_IDS=0,1

# REQUIRED for Spotify Playlists (due to Spotify dropping anonymous scraping support)
# Get these for free at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional, but recommended when Spotify returns 403 on playlist items.
# App-only credentials can work for some public playlists (especially in Extended Quota),
# but can be blocked in Development mode.
# Use a USER OAuth token for reliability.
# Scopes for private/collaborative playlists: playlist-read-private playlist-read-collaborative
SPOTIFY_USER_SCOPES="playlist-read-private playlist-read-collaborative"
SPOTIFY_USER_ACCESS_TOKEN=
SPOTIFY_USER_REFRESH_TOKEN=
SPOTIFY_USER_TOKEN_EXPIRES_AT=

# Optional: background parallel lookups for Spotify playlist enrichment.
# Lower this (e.g. 2-4) if Lavalink search starts failing in bursts.
SPOTIFY_BACKGROUND_SEARCH_CONCURRENCY=4

# Cache resolved Lavalink target links (YouTube/YouTube Music URLs) for repeat tracks.
RESOLVED_TRACK_CACHE_ENABLED=1
# Backward-compatible fallback TTL for legacy unscoped cache keys.
RESOLVED_TRACK_CACHE_TTL_SECONDS=2592000
# Direct user-input resolver cache (daily by default).
TRACK_RESOLVER_USER_CACHE_TTL_SECONDS=86400
# Playlist resolver cache (weekly by default).
TRACK_RESOLVER_PLAYLIST_CACHE_TTL_SECONDS=604800
# Spotify playlist extraction snapshot cache (weekly by default).
SPOTIFY_PLAYLIST_CACHE_TTL_SECONDS=604800

# Advanced track resolver tuning.
# Higher values trade more search latency for better match quality.
TRACK_RESOLVER_PER_QUERY_LIMIT=12
TRACK_RESOLVER_MAX_CANDIDATES=60
TRACK_RESOLVER_RRF_K=20
TRACK_RESOLVER_RRF_SCALE=320

# Only cache resolver outputs that have enough confidence.
TRACK_RESOLVER_MIN_CACHE_SCORE=58
TRACK_RESOLVER_MIN_CACHE_MARGIN=5

# Optional ML reranker (disabled by default). Requires:
# pip install sentence-transformers torch
TRACK_RESOLVER_ML_RERANK_ENABLED=0
TRACK_RESOLVER_ML_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TRACK_RESOLVER_ML_RERANK_WEIGHT=22
TRACK_RESOLVER_ML_MAX_CANDIDATES=30

# Lyrics resolution
# Provider order:
# 1) LRCLIB exact metadata match
# 2) Optional unofficial Spotify synced lyrics
# 3) LRCLIB search fallback
# 4) lyrics.ovh
# 5) Genius (if GENIUS_ACCESS_TOKEN is set)
LYRICS_CACHE_ENABLED=1
LYRICS_CACHE_TTL_SECONDS=604800
LYRICS_PREFER_SYNCED=0
LYRICS_LRCLIB_EXACT_MIN_SCORE=118
LYRICS_LRCLIB_SEARCH_MIN_SCORE=86

# Optional unofficial Spotify synced-lyrics provider.
# Requires either:
# - SPOTIFY_CLIENT_ID + SPOTIFY_CLIENT_SECRET (for track-id lookup), or
# - SPOTIFY_USER_ACCESS_TOKEN, or
# - directly passing Spotify track links/IDs.
LYRICS_SPOTIFY_UNOFFICIAL_ENABLED=0
LYRICS_SPOTIFY_MARKET=US
# Optional override. If empty and auto mode is on, token is fetched from open.spotify.com.
LYRICS_SPOTIFY_WEB_TOKEN=
LYRICS_SPOTIFY_WEB_TOKEN_AUTO=1

# Optional: enables Genius fallback provider.
# Create at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Dashboard live progress refresh rate in seconds (minimum 1).
UI_REFRESH_INTERVAL_SECONDS=0.49

# Lavalink server password (must match application.yml).
LAVALINK_PASSWORD=youshallnotpass
