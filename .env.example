DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Optional: shard for higher scale guild counts.
# Keep disabled for small bots. Enable when you need horizontal gateway scaling.
AUTO_SHARDING_ENABLED=0
# Optional when auto sharding is enabled:
# DISCORD_SHARD_COUNT=2
# DISCORD_SHARD_IDS=0,1

# REQUIRED for Spotify Playlists (due to Spotify dropping anonymous scraping support)
# Get these for free at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional, but recommended when Spotify returns 403 on playlist items.
# App-only credentials can work for some public playlists (especially in Extended Quota),
# but can be blocked in Development mode.
# Use a USER OAuth token for reliability.
# Scopes for private/collaborative playlists: playlist-read-private playlist-read-collaborative
SPOTIFY_USER_SCOPES="playlist-read-private playlist-read-collaborative"
SPOTIFY_USER_ACCESS_TOKEN=
SPOTIFY_USER_REFRESH_TOKEN=
SPOTIFY_USER_TOKEN_EXPIRES_AT=

# Optional: background parallel lookups for Spotify playlist enrichment.
# Lower this (e.g. 2-4) if Lavalink search starts failing in bursts.
SPOTIFY_BACKGROUND_SEARCH_CONCURRENCY=4

# Cache resolved Lavalink target links (YouTube/YouTube Music URLs) for repeat tracks.
RESOLVED_TRACK_CACHE_ENABLED=1
RESOLVED_TRACK_CACHE_TTL_SECONDS=2592000

# Dashboard live progress refresh rate in seconds (minimum 1).
UI_REFRESH_INTERVAL_SECONDS=0.49

# Lavalink server password (must match application.yml).
LAVALINK_PASSWORD=youshallnotpass
